# ==============================================================================
# Stryde App - Git Ignore Specification
# ==============================================================================
# This .gitignore covers Flutter, Dart, Android, iOS, Supabase, Web,
# IDEs, OS metadata, and strictly guards against security vulnerabilities
# such as leaked private keys, signing keystores, service tokens, and env files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY, CREDENTIALS & SENSITIVE KEYS (DO NOT COMMIT)
# ------------------------------------------------------------------------------
# Environment variables and local configs (contains secrets / API keys)
.env
.env.*
*.env
*.env.json
dart_defines.json
define_*.json
!*.env.example
!*.env.template

# Android keystores, signing certificates, and credentials
*.jks
*.keystore
*.pk8
*.der
key.properties
signing.properties
keystore.properties
**/key.properties
**/signing.properties
**/keystore.properties

# iOS & Apple developer credentials, provisioning profiles, and certificates
*.p12
*.pfx
*.cer
*.crt
*.pem
*.key
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
ExportOptions.plist

# Google Cloud / Firebase service accounts & configuration containing client secrets
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
service-account*.json
credentials.json
firebase-debug.log*

# Supabase local state & secret files
.supabase/
supabase/.temp/
supabase/.branches/
supabase/.env*
!supabase/.env.example

# Database dumps, backups & SQLite files
*.dump
*.sql.gz
*.bak
*.sqlite
*.sqlite-journal
*.sqlite3

# ------------------------------------------------------------------------------
# 2. FLUTTER & DART GENERATED FILES & BUILD ARTIFACTS
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
.widget_preview/

# Root and nested build outputs
build/
**/build/
coverage/
**/doc/api/
.test_runtime/

# Crashlytics, symbolication & obfuscation maps
*.symbols
app.*.symbols
*.map
app.*.map.json
*.dSYM/
*.dSYM.zip

# ------------------------------------------------------------------------------
# 3. ANDROID GENERATED FILES & LOCAL CACHES
# ------------------------------------------------------------------------------
# Machine-specific paths (leaks local username & SDK paths, breaks other machines)
local.properties
**/local.properties

# Gradle & Kotlin caches and daemon files
.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
captures/
**/captures/
.cxx/
**/.cxx/

# Android Studio / Gradle build artifacts
android/app/debug/
android/app/profile/
android/app/release/

# Generated plugin registrant
**/GeneratedPluginRegistrant.java

# ------------------------------------------------------------------------------
# 4. IOS & MACOS EPHEMERAL FILES & FRAMEWORKS
# ------------------------------------------------------------------------------
# Ephemeral build scripts & configs generated by Flutter (leaks user path & env)
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
**/ios/Flutter/.last_build_id
Flutter/App.framework
Flutter/Flutter.framework
Flutter/Flutter.podspec
Flutter/Generated.xcconfig
Flutter/app.flx
Flutter/app.zip
Flutter/flutter_assets/
Flutter/flutter_export_environment.sh
Flutter/ephemeral/

# CocoaPods & Swift Package Manager dependencies
**/Pods/
**/.symlinks/
**/.build/
**/DerivedData/

# Xcode user data & schemes (leaks personal developer state)
xcuserdata/
**/xcuserdata/
*.xcuserdatad
*.xcuserstate

# Generated plugin registrant
**/Runner/GeneratedPluginRegistrant.*
**/Runner/GeneratedPluginRegistrant.h
**/Runner/GeneratedPluginRegistrant.m

# ------------------------------------------------------------------------------
# 5. BUILT PACKAGES & RELEASE BINARIES (AVOID GITHUB 100MB LIMIT & REPO BLOAT)
# ------------------------------------------------------------------------------
*.apk
*.aab
*.ipa
*.xcarchive
*.app
*.xpi
*.exe
*.dll
*.so
*.dylib

# Releases and concepts directories
releases/


# ------------------------------------------------------------------------------
# 6. WEB, NODE & FRONTEND ARTIFACTS (FOR LANDING PAGES / WEB BUILDS)
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 7. IDE & EDITOR FILES
# ------------------------------------------------------------------------------
# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.ipr
*.iws
cmake-build-*/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# ------------------------------------------------------------------------------
# 8. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Icon?

# Windows
Desktop.ini
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# Generic log & temporary files
*.log
*.tmp
*.bak
*.swp
*.swo
